# Google Cloud Console(https://console.cloud.google.com/apis/credentials)에서
# "OAuth 클라이언트 ID" (유형: 웹 애플리케이션)를 만들고, 아래 값을 채워주세요.
# 승인된 자바스크립트 원본(Authorized JavaScript origins)에 http://localhost:5173 을 추가해야 합니다.
#
# 같은 클라이언트 ID를 client/.env 의 VITE_GOOGLE_CLIENT_ID 에도 넣어야 합니다.
GOOGLE_CLIENT_ID=여기에_구글_클라이언트_ID.apps.googleusercontent.com

# 앱이 자체 발급하는 로그인 토큰(JWT) 서명용 비밀키. 실서비스 배포 전에 반드시 바꾸세요.
JWT_SECRET=change-this-to-a-random-secret

PORT=2567

# --- 개발자 전용 관리 페이지 (/manager, /monitor) ---
# 둘 다 HTTP Basic Auth로 보호됩니다. MANAGER_PASSWORD를 설정하지 않으면 페이지 자체가 열리지 않습니다.
MANAGER_USER=admin
MANAGER_PASSWORD=change-this-too

# --- 인게임 관리자 화이트리스트 ---
# 여기 적힌 구글 이메일로 로그인하면 게임 안에서 이름 앞에 👑 표시가 붙습니다 (쉼표로 여러 개 구분).
# 서버가 로그인 토큰을 직접 검증해서 판단하므로 클라이언트 조작으로는 얻을 수 없습니다.
ADMIN_EMAILS=you@gmail.com,teammate@gmail.com

# --- 데이터베이스 (필수) ---
# 로그인 계정/차단 목록을 저장하는 Postgres 연결 문자열입니다.
# Render 무료 플랜은 파일 시스템이 재배포마다 초기화돼서 SQLite 파일을 못 씁니다.
# 무료로 계속 쓸 수 있는 곳 추천: Neon(neon.tech), Supabase(supabase.com) — 둘 다 만료 없는 무료 Postgres 제공.
# (Render 자체 무료 Postgres는 생성 30일 후 만료되니 이 프로젝트엔 안 맞습니다.)
# 형식: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- 관리자가 업로드하는 방(.glb) 파일 저장소 (선택) ---
# 위 DATABASE_URL이 Supabase Postgres 연결 문자열이라면(호스트가 db.<프로젝트>.supabase.co 또는
# ....pooler.supabase.com 형태), 프로젝트 주소는 거기서 자동으로 알아내므로 아래 키 하나만 채우면 됩니다.
# (DATABASE_URL로 Neon 등 다른 DB를 쓰면서 Storage만 Supabase를 쓰고 싶다면 SUPABASE_URL도 같이 적어주세요.)
#
# 이걸 설정하면 /manager 에서 업로드한 .glb 파일이 로컬 디스크 대신 Supabase Storage에 영구 저장됩니다.
# Render 무료 플랜처럼 파일 시스템이 재배포마다 초기화되는 곳에 배포한다면 반드시 설정하세요
# (안 그러면 재배포할 때마다 업로드한 방 파일이 사라집니다). 로컬 개발은 비워둬도 정상 동작합니다
# (그 경우 server/uploads/models/ 에 저장됨).
#
# 설정 방법:
# 1. Supabase 대시보드 → Storage → New bucket → 이름 "room-models", "Public bucket" 켜기
#    (비공개로 두면 클라이언트가 .glb를 못 불러옵니다 — 개인정보가 없는 3D 에셋이라 공개해도 안전합니다)
# 2. Supabase 대시보드 → Project Settings → API → "service_role" 키(secret! anon 키 아님) 복사
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
#
# DATABASE_URL이 Supabase가 아니어서 자동 추출이 안 될 때만 아래 두 개도 채워주세요:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_STORAGE_BUCKET=room-models

# --- 배포 시에만 필요 (로컬 개발은 비워둬도 됨) ---

# 배포된 클라이언트 도메인. 여러 개면 콤마로 구분 (예: 미리보기 URL 포함).
# 비워두면 모든 origin을 허용합니다 (로컬 개발 기본값).
# ALLOWED_ORIGIN=https://nexus-client.onrender.com
